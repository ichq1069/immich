# ============================================
# Immich + Cloudflare R2 一键部署配置
# 复制此文件为 .env 并填入真实值
# ============================================

# ---------- R2 对象存储 ----------
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=immich

# ---------- 存储路径 ----------
# 照片/视频 -> R2 挂载点（rclone 容器自动挂载，无需手动操作）
UPLOAD_LOCATION=/root/immich-app/r2-immich-photo
# 数据库 -> 本地 SSD（绝对不能放 R2/网络存储）
DB_DATA_LOCATION=/root/immich-app/postgres

# ---------- 数据库 ----------
DB_USERNAME=postgres
DB_PASSWORD=请生成随机密码替换这里
DB_DATABASE_NAME=immich

# ---------- Redis ----------
REDIS_HOSTNAME=immich_redis

# ---------- 通用 ----------
TZ=Asia/Shanghai
IMMICH_VERSION=v3
IMMICH_MACHINE_LEARNING_URL=http://immich-machine-learning:3003